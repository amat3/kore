{
  "name": "kore",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build":        "turbo build",
    "dev":          "turbo dev",
    "lint":         "turbo lint",
    "tokens:build": "turbo build --filter=@kore/tokens",
    "tokens:watch": "turbo dev --filter=@kore/tokens"
  },
  "devDependencies": {
    "turbo":      "^2.3.0",
    "typescript": "^5.5.0"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "packageManager": "npm@10.8.0"
}
