{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "target":          "ES2020",
    "module":          "ESNext",
    "moduleResolution":"bundler",
    "lib":             ["ES2020"],
    "outDir":          "./dist",
    "declaration":     true,
    "declarationMap":  true,
    "sourceMap":       true
  },
  "include": ["src/**/*.ts"],
  "exclude": ["src/scripts", "dist", "node_modules"]
}
