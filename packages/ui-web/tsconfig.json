{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "target":            "ES2020",
    "module":            "ESNext",
    "moduleResolution":  "bundler",
    "lib":               ["ES2020", "DOM", "DOM.Iterable"],
    "jsx":               "react-jsx",
    "rootDir":           ".",
    "outDir":            "./dist",
    "declaration":       true,
    "declarationMap":    true,
    "sourceMap":         true
  },
 "include": ["src/**/*.ts", "src/**/*.tsx", "declarations.d.ts"],
  "exclude": ["dist", "node_modules", "**/*.stories.tsx"]
}
